# Server Configuration
PORT=5000
NODE_ENV=development

# Admin Authentication
ADMIN_SECRET_KEY=rahul_admin_secret_key_change_in_production
ADMIN_PASSWORD=admin12345

# Contact Form & Email Notification Settings (Optional)
# If left empty, contact messages are safely stored in the database without sending emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=rahuldheeraj.anil@gmail.com

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000


# Google Gemini API Key for Rahul-Bot (Optional)
# If left empty, Rahul-Bot runs on the high-speed local knowledge engine
GEMINI_API_KEY=
